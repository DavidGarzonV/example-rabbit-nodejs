# Application environment
NODE_ENV=local

# RabbitMQ connection
RABBITMQ_PROTOCOL=amqp
RABBITMQ_URL=localhost:5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# RabbitMQ messaging
RABBITMQ_QUEUE=test-queue
RABBITMQ_QUEUE_TYPE=classic
RABBITMQ_EXCHANGE=status
RABBITMQ_ROUTING_KEY=online

# JWT token configuration (JSON)
# Set all three variables to generate the token message header.
# JWT_HEADER_NAME=id-token
# JWT_PAYLOAD={"document_type":"TIPDOC_FS003","document_number":"123456789","user_document_number":"45456456","user_document_type":"TIPDOC_FS003"}
# JWT_HEADER={"kid":"test-key-1"}

# For a remote broker, use values such as:
# RABBITMQ_PROTOCOL=amqps
# RABBITMQ_URL=your-broker-host
# RABBITMQ_USER=your-user
# RABBITMQ_PASSWORD=your-password
# RABBITMQ_VHOST=/
